# irisImg Nginx 示例配置 —— HTTP 最简版（便于先跑通）
#
# 注意：HTTP 模式下请把 config.yaml 的 apikey.https_only 改为 false，
# 否则密钥创建/重置/吊销等敏感接口会因 X-Forwarded-Proto != https 被拒。
# 生产请改用 irisImg.conf（HTTPS）并保持 https_only=true。

server {
    listen 80;
    server_name _;   # 或你的域名/IP

    root /opt/irisImg/web;
    index index.html;
    # 上限须大于 storage.audio_max_upload_size_mb（默认 100），这里按 150m 对齐。
    client_max_body_size 150m;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 100MB 音频经慢速上行链路上传时可能超过 60s，放宽到 300s。
        proxy_read_timeout 300s;
    }

    location /imgs/ {
        # 仅放行图片扩展名（与后端 serveImages 白名单对齐的纵深防御）：
        # 即便 storage.root_dir 误配或目录混入非图片文件，也无法经 /imgs/ 下载
        # .yaml/.db/.go 等。扩展名须与 config.yaml storage.allowed_mime_types 对齐，
        # 新增图片类型时这里与后端 internal/router/static.go 的 imageMimeExt 都要改。
        # if + return 是 nginx if 指令的少数 100% 安全用法。
        if ($uri !~* \.(png|jpg|jpeg|gif|webp)$) {
            return 404;
        }
        alias /opt/irisImg/data/imgs/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location /audios/ {
        # 音频静态服务：与 /imgs/ 同款纵深防御；白名单额外放行图片扩展名，
        # 因内嵌封面落在 <audio_root>/covers/ 下（三方对齐：本 regex
        # <-> storage.audio_allowed_mime_types <-> static.go 的 audioMimeExt）。
        if ($uri !~* \.(mp3|m4a|flac|png|jpg|jpeg|gif|webp)$) {
            return 404;
        }
        alias /opt/irisImg/data/audios/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
