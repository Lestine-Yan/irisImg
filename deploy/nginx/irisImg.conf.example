# irisImg Nginx 示例配置 -- HTTPS，443 端口（与其他站点按子域名 SNI 分流）
#
# 适用场景：服务器 443 上已有其他站点（如主站），irisImg 用独立子域名（如 img.example.com）
# 共享 443，靠 SNI（TLS 握手时的 server_name）分流，互不冲突，访问时无需带端口。
#
# 部署步骤：
#   1. 拷到 /etc/nginx/conf.d/irisImg.conf（或宝塔对应站点配置）
#   2. 全局替换 your-domain.com 为你的子域名（如 img.example.com）
#   3. 申请该子域名的证书：certbot --nginx -d your-domain.com，或宝塔申请
#   4. 确认 DNS：该子域名 A 记录指向本服务器
#   5. nginx -t 测试 && systemctl reload nginx
#
# 前置：release 包解压到 /opt/irisImg，后端已由 systemd / start.sh 启动在 127.0.0.1:8080。
# 原理：nginx 对同端口(443)不同 server_name 的 server block 按 SNI 分流，各站点用各自证书，
#       互不干扰。80 端口不在此配置内（由主站或宝塔处理 HTTP->HTTPS 跳转）。
#
# 限流说明（应用层之外的第二道防线，无需 Redis）：
# - 全部 zone 必须定义在 http 上下文；本文件放在 conf.d/ 下时顶层即 http，可直接使用。
# - 只允许启用本文件与 irisImg.http.conf.example 中的一个：同名 zone 重复定义会让 nginx -t 失败。
# - $binary_remote_addr 不受 X-Forwarded-For 影响，客户端无法伪造；若日后接入 CDN，
#   需先配置 real_ip 模块并在 server.trusted_proxies 追加 CDN 网段。
limit_req_zone $binary_remote_addr zone=iris_login:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=iris_api:10m rate=60r/m;
limit_req_zone $binary_remote_addr zone=iris_media:10m rate=600r/m;
limit_conn_zone $binary_remote_addr zone=iris_conn:10m;
limit_req_status 429;
limit_conn_status 429;

server {
    listen 443 ssl;
    http2 on;
    server_name your-domain.com;

    ssl_certificate     /etc/letsencrypt/live/your-domain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your-domain.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # 安全响应头(HSTS 强制后续访问走 HTTPS、缓解首访降级;nosniff 防 MIME 嗅探;X-Frame-Options 防点击劫持)。
    # 注意 nginx add_header 继承规则:location 内一旦出现 add_header,server 级不再继承,
    # 故下方 /imgs/、/audios/ 块(自带 Cache-Control)需重申这些安全头。
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # 前端 SPA 静态根
    root /opt/irisImg/web;
    index index.html;
    # 上限须大于 storage.audio_max_upload_size_mb（默认 100，无损格式体积大），
    # 这里按 150m 对齐；图片上传仍由后端 max_upload_size_mb=20 精确限制。
    client_max_body_size 150m;

    # 单 IP 并发连接上限（server 级），缓解慢连接 / 连接耗尽型泛洪。
    limit_conn iris_conn 25;

    # 用 HTTP 访问 443 时（443 是 ssl 端口）跳转 HTTPS
    error_page 497 https://$host$request_uri;

    # SPA 路由刷新兜底
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 登录接口单独限流：更严格的 5r/m + burst 3，挡住密码爆破洪峰。
    # 应用层还有「按 IP 失败计数 + 长锁定」，两者互补（Nginx 挡短期洪峰，应用层让该 IP 长期无法再试）。
    location = /api/v1/auth/login {
        limit_req zone=iris_login burst=3 nodelay;
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # 只传 TCP 对端地址，丢弃客户端自带的 X-Forwarded-For（防 IP 伪造）。
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    # 后端 API 反代：保留 /api 前缀转发到 8080
    # /api/v1/ping -> http://127.0.0.1:8080/api/v1/ping
    # 60r/m 覆盖无效密钥探测（鉴权失败也会查库），burst 30 容纳后台页面并发。
    location /api/ {
        limit_req zone=iris_api burst=30 nodelay;
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # 只传 TCP 对端地址；后端 Gin 的 trusted_proxies 会据此得到不可伪造的 ClientIP。
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;   # 后端 https_only 据此校验
        # 100MB 音频经慢速上行链路上传时可能超过 60s，放宽到 300s（对图片上传无影响）。
        proxy_read_timeout 300s;
    }

    # 图片静态服务：直接 serve 落盘目录（路径须与 config.yaml storage.root_dir 一致）
    location /imgs/ {
        # 静态资源限流：600r/m/burst100 足以覆盖画廊整页并发缩略图，但能挡住脚本化批量抓取。
        limit_req zone=iris_media burst=100 nodelay;
        limit_conn iris_conn 12;
        # 防盗链（默认关闭）。nginx 的 valid_referers 是静态指令，无法用「列表为空」自动关闭，
        # 因此用注释作为开关：保持注释 = 不启用；取消两行注释并按需追加站点 = 启用白名单。
        # 启用后：无 Referer 的直接访问仍放行；未列入白名单的外部站点嵌入图片会 403。
        # valid_referers none blocked server_names blog.example.com;
        # if ($invalid_referer) { return 403; }

        # 仅放行图片扩展名（与后端 serveImages 白名单对齐的纵深防御）：
        # 即便 storage.root_dir 误配成工作目录、或目录里混入非图片文件，也无法经 /imgs/
        # 下载 .yaml/.db/.go 等敏感文件。扩展名须与 config.yaml storage.allowed_mime_types
        # 对齐，新增图片类型时这里与后端 internal/router/static.go 的 imageMimeExt 都要改。
        # 用 $uri（已归一化、无 query string）避免带参数的图片请求被误杀。
        # if + return 是 nginx if 指令的少数 100% 安全用法（见 nginx IfIsEvil）。
        if ($uri !~* \.(png|jpg|jpeg|gif|webp)$) {
            return 404;
        }
        alias /opt/irisImg/data/imgs/;
        expires 30d;
        add_header Cache-Control "public, immutable";
        # 本 location 已有 add_header,server 级安全头不再继承,需重申
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # 音频静态服务：与 /imgs/ 同款纵深防御（路径须与 config.yaml storage.audio_root_dir 一致）。
    # 白名单除 mp3/m4a/flac 外还放行图片扩展名——音频内嵌封面抽取后落在
    # <audio_root>/covers/ 下，与音频文件共用 /audios/ 前缀；扩展名三方对齐：
    # 本 regex <-> config.yaml storage.audio_allowed_mime_types(+allowed_mime_types 封面)
    # <-> 后端 internal/router/static.go 的 audioMimeExt。nginx 原生支持 Range 请求，
    # 音频拖动进度条无需额外配置。
    location /audios/ {
        # 与 /imgs/ 同款限流；防盗链同样默认关闭，启用方式见 /imgs/ 处的注释。
        limit_req zone=iris_media burst=100 nodelay;
        limit_conn iris_conn 12;

        if ($uri !~* \.(mp3|m4a|flac|png|jpg|jpeg|gif|webp)$) {
            return 404;
        }
        alias /opt/irisImg/data/audios/;
        expires 30d;
        add_header Cache-Control "public, immutable";
        # 本 location 已有 add_header,server 级安全头不再继承,需重申
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }
}
